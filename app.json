{
  "expo": {
    "name": "CouCouMontreal",
    "slug": "coucoumontreal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "scheme": "coucoumontreal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CouCouMTL to use your location to suggest a fair public meeting place."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CouCou Montréal to use a photo as your profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF078",
          "image": "./assets/images/splash-paw.png",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
